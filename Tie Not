<!<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>George & Emmaculate | 31 December 2026 | Siaya</title>
<meta name="description" content="Join us as George and Emmaculate say 'I do' in Siaya on 31 December 2026.">
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=Great+Vibes&family=Playfair+Display:ital,wght@0,400;0,600;0,700;1,400&family=Poppins:wght@300;400;500;600&display=swap" rel="stylesheet">

<style>
  /* ============ COLOURS - change these to restyle the whole site ============ */
  :root{
    --magenta:#d6246e;
    --coral:#ff6b4a;
    --gold:#f4b400;
    --teal:#0fa3a3;
    --purple:#6a2c91;
    --cream:#f7c948;
    --ink:#2b1a33;
    --grad: linear-gradient(135deg,var(--magenta),var(--coral) 50%,var(--gold));
    --grad2: linear-gradient(135deg,var(--purple),var(--magenta));
  }
  *{box-sizing:border-box;margin:0;padding:0}
  html{scroll-behavior:smooth}
  body{font-family:'Poppins',sans-serif;color:var(--ink);background:var(--cream);line-height:1.7;overflow-x:hidden}
  h1,h2,h3{font-family:'Playfair Display',serif}
  .script{font-family:'Great Vibes',cursive;font-weight:400}
  a{color:inherit}
  section{padding:90px 20px;position:relative}
  .wrap{max-width:1050px;margin:0 auto}
  .title{text-align:center;margin-bottom:50px}
  .title .script{font-size:2.2rem;color:var(--magenta);display:block}
  .title h2{font-size:clamp(2rem,5vw,3rem);background:var(--grad2);-webkit-background-clip:text;background-clip:text;color:transparent}
  .title .line{width:120px;height:4px;border-radius:4px;background:var(--grad);margin:14px auto 0}

  /* ============ NAV ============ */
  nav{position:fixed;top:0;left:0;right:0;z-index:50;display:flex;justify-content:center;gap:6px;flex-wrap:wrap;
      padding:12px 10px;background:rgba(43,26,51,.55);backdrop-filter:blur(10px);transition:.3s}
  nav a{color:#fff;text-decoration:none;font-size:.85rem;padding:6px 14px;border-radius:30px;letter-spacing:.5px}
  nav a:hover{background:var(--grad)}

  /* ============ HERO ============ */
  .hero{min-height:100vh;display:flex;align-items:center;justify-content:center;text-align:center;color:#fff;
    background:
      linear-gradient(160deg,rgba(106,44,145,.78),rgba(214,36,110,.62) 50%,rgba(244,180,0,.45)),
      url('images/hero.jpg') center/cover no-repeat,
      var(--grad2);
    padding-top:80px}
  .hero .small{letter-spacing:6px;text-transform:uppercase;font-size:.9rem;opacity:.95}
  .hero h1{font-family:'Great Vibes',cursive;font-weight:400;font-size:clamp(3.6rem,13vw,8rem);line-height:1.05;margin:10px 0;text-shadow:0 4px 25px rgba(0,0,0,.35)}
  .hero h1 .amp{display:block;font-size:.55em;color:var(--gold)}
  .hero .date{font-size:clamp(1.1rem,3vw,1.6rem);letter-spacing:3px;margin-top:8px}
  .hero .place{opacity:.95;margin-bottom:34px}
  .countdown{display:flex;gap:14px;justify-content:center;flex-wrap:wrap;margin:10px 0 36px}
  .countdown div{width:92px;padding:14px 6px;border-radius:18px;background:rgba(255,255,255,.18);border:1px solid rgba(255,255,255,.4);backdrop-filter:blur(6px)}
  .countdown b{display:block;font-size:2rem;font-family:'Playfair Display',serif}
  .countdown span{font-size:.72rem;letter-spacing:2px;text-transform:uppercase}
  .btn{display:inline-block;padding:14px 34px;border-radius:40px;background:var(--gold);color:var(--ink);font-weight:600;
       text-decoration:none;border:none;cursor:pointer;font-size:1rem;font-family:inherit;transition:.25s;box-shadow:0 8px 22px rgba(0,0,0,.25)}
  .btn:hover{transform:translateY(-3px) scale(1.03);background:#fff}

  /* floating hearts */
  .hearts{position:absolute;inset:0;overflow:hidden;pointer-events:none}
  .hearts i{position:absolute;bottom:-40px;font-style:normal;opacity:.7;animation:rise linear infinite}
  @keyframes rise{to{transform:translateY(-115vh) rotate(40deg);opacity:0}}

  /* ============ STORY ============ */
  .story{background:linear-gradient(180deg,#ffd978,#f2b632)}
  .couple{display:grid;grid-template-columns:1fr 1fr;gap:30px;margin-bottom:50px}
  .person{text-align:center}
  .person .photo{width:230px;height:230px;margin:0 auto 18px;border-radius:50%;
    background:url('images/bride.jpg') center/cover,var(--grad);
    border:6px solid #fff;box-shadow:0 0 0 5px var(--magenta),0 14px 30px rgba(214,36,110,.3)}
  .person.groom .photo{background:url('images/groom.jpg') center/cover,var(--grad2);box-shadow:0 0 0 5px var(--teal),0 14px 30px rgba(15,163,163,.3)}
  .person h3{font-size:1.8rem;color:var(--purple)}
  .person small{color:var(--magenta);letter-spacing:3px;text-transform:uppercase;font-weight:600}
  .story p.text{max-width:720px;margin:0 auto 16px;text-align:center;font-size:1.05rem}

  /* ============ DETAILS ============ */
  .details{background:linear-gradient(180deg,#f2b632,#ffd978)}
  .cards{display:grid;grid-template-columns:repeat(auto-fit,minmax(260px,1fr));gap:26px}
  .card{background:#fff;border-radius:24px;padding:36px 26px;text-align:center;box-shadow:0 12px 35px rgba(106,44,145,.12);
        border-top:6px solid var(--magenta);transition:.3s}
  .card:nth-child(2){border-color:var(--gold)}
  .card:nth-child(3){border-color:var(--teal)}
  .card:hover{transform:translateY(-8px)}
  .card .ico{font-size:2.6rem}
  .card h3{margin:8px 0;color:var(--purple)}
  .map{margin-top:40px;border-radius:24px;overflow:hidden;box-shadow:0 12px 35px rgba(0,0,0,.15)}
  .map iframe{width:100%;height:340px;border:0;display:block}

  /* ============ SCHEDULE ============ */
  .timeline{max-width:640px;margin:0 auto;position:relative;padding-left:34px}
  .timeline:before{content:"";position:absolute;left:10px;top:6px;bottom:6px;width:4px;border-radius:4px;background:var(--grad)}
  .tl{position:relative;margin-bottom:28px;background:#fff;padding:16px 22px;border-radius:16px;box-shadow:0 6px 20px rgba(0,0,0,.08)}
  .tl:before{content:"";position:absolute;left:-33px;top:22px;width:18px;height:18px;border-radius:50%;background:var(--gold);border:4px solid var(--magenta)}
  .tl b{color:var(--magenta)}

  /* ============ GALLERY ============ */
  .gallery{background:var(--ink)}
  .gallery .title h2{background:linear-gradient(135deg,var(--gold),#fff);-webkit-background-clip:text;background-clip:text}
  .grid{display:grid;grid-template-columns:repeat(auto-fill,minmax(220px,1fr));gap:14px}
  .grid div{aspect-ratio:1;border-radius:18px;background-size:cover;background-position:center;transition:.35s;cursor:pointer}
  .grid div:hover{transform:scale(1.04) rotate(-1deg)}
  .g1{background-image:url('images/g1.jpg'),linear-gradient(135deg,#d6246e,#ff6b4a)}
  .g2{background-image:url('images/g2.jpg'),linear-gradient(135deg,#f4b400,#ff6b4a)}
  .g3{background-image:url('images/g3.jpg'),linear-gradient(135deg,#0fa3a3,#6a2c91)}
  .g4{background-image:url('images/g4.jpg'),linear-gradient(135deg,#6a2c91,#d6246e)}
  .g5{background-image:url('images/g5.jpg'),linear-gradient(135deg,#ff6b4a,#f4b400)}
  .g6{background-image:url('images/g6.jpg'),linear-gradient(135deg,#0fa3a3,#f4b400)}
  .g7{background-image:url('images/g7.jpg'),linear-gradient(135deg,#d6246e,#6a2c91)}
  .g8{background-image:url('images/g8.jpg'),linear-gradient(135deg,#f4b400,#0fa3a3)}

  /* ============ WISHES ============ */
  .wishes{background:linear-gradient(180deg,#f2b632,#ffd978);text-align:center}
  .wish-card{max-width:760px;margin:0 auto;background:#fff;border-radius:28px;padding:50px 34px;
    box-shadow:0 16px 45px rgba(106,44,145,.25);border:3px solid var(--gold);position:relative}
  .wish-card .heart{font-size:2.6rem}
  .wish-card h3{font-size:1.9rem;color:var(--purple);margin:6px 0 14px}
  .wish-card p{font-size:1.1rem;margin-bottom:14px}
  .wish-card .sign{font-family:'Great Vibes',cursive;font-size:2.4rem;color:var(--magenta);margin-top:18px}

  /* ============ RSVP ============ */
  .rsvp{background:linear-gradient(135deg,var(--purple),var(--magenta));color:#fff}
  .rsvp .title h2,.rsvp .title .script{color:#fff;background:none;-webkit-text-fill-color:#fff}
  form{max-width:560px;margin:0 auto;display:grid;gap:14px}
  input,select,textarea{width:100%;padding:14px 18px;border-radius:14px;border:none;font:inherit;color:var(--ink)}
  textarea{min-height:100px;resize:vertical}
  .rsvp p.note{text-align:center;margin-bottom:24px}

  footer{background:var(--ink);color:#fff;text-align:center;padding:50px 20px}
  footer .script{font-size:2.8rem;color:var(--gold)}

  @media(max-width:640px){
    .couple{grid-template-columns:1fr}
    section{padding:70px 16px}
    nav a{padding:5px 9px;font-size:.75rem}
  }
  /* fade-in on scroll */
  .reveal{opacity:0;transform:translateY(30px);transition:1s}
  .reveal.show{opacity:1;transform:none}
</style>
</head>
<body>

<nav>
  <a href="#home">Home</a><a href="#story">Us</a><a href="#details">Details</a>
  <a href="#schedule">Schedule</a><a href="#gallery">Gallery</a><a href="#rsvp">RSVP</a>
</nav>

<!-- ============ HERO ============ -->
<header class="hero" id="home">
  <div class="hearts" id="hearts"></div>
  <div style="position:relative;padding:20px">
    <p class="small">We are getting married</p>
    <h1>George <span class="amp">&</span> Emmaculate</h1>
    <p class="date">31 · DECEMBER · 2026</p>
    <p class="place">📍 Siaya, Kenya</p>
    <div class="countdown" id="countdown">
      <div><b id="d">0</b><span>Days</span></div>
      <div><b id="h">0</b><span>Hours</span></div>
      <div><b id="m">0</b><span>Minutes</span></div>
      <div><b id="s">0</b><span>Seconds</span></div>
    </div>
    <a href="#rsvp" class="btn">RSVP Now</a>
  </div>
</header>

<!-- ============ OUR STORY ============ -->
<section class="story reveal" id="story">
  <div class="wrap">
    <div class="title"><span class="script">The Happy Couple</span><h2>Our Love Story</h2><div class="line"></div></div>
    <div class="couple">
      <div class="person">
        <div class="photo"></div>
        <small>The Bride</small>
        <h3>George</h3>
      </div>
      <div class="person groom">
        <div class="photo"></div>
        <small>The Groom</small>
        <h3>Emmaculate</h3>
      </div>
    </div>
    <p class="text">Two hearts, one journey. What started as friendship grew into a love that makes every day brighter and more colourful.</p>
    <p class="text">On the last day of 2026, we will end the year by starting forever together. We would be honoured to have you celebrate with us.</p>
    <!-- ✏️ Replace the text above with your own story -->
  </div>
</section>

<!-- ============ DETAILS ============ -->
<section class="details reveal" id="details">
  <div class="wrap">
    <div class="title"><span class="script">Save the Date</span><h2>Wedding Details</h2><div class="line"></div></div>
    <div class="cards">
      <div class="card"><div class="ico">💒</div><h3>Ceremony</h3>
        <p><b>31 December 2026</b><br>11:00 AM<br>Siaya, Kenya<br><small>(Add church / venue name)</small></p></div>
      <div class="card"><div class="ico">🥂</div><h3>Reception</h3>
        <p><b>31 December 2026</b><br>2:00 PM onwards<br>Siaya, Kenya<br><small>(Add reception venue)</small></p></div>
      <div class="card"><div class="ico">👗</div><h3>Dress Code</h3>
        <p>Bright &amp; colourful!<br>Think magenta, gold, teal and coral.<br>Come ready to dance 💃🕺</p></div>
    </div>
    <div class="map">
      <iframe loading="lazy" title="Map of Siaya" src="https://www.google.com/maps?q=Siaya,Kenya&output=embed"></iframe>
    </div>
  </div>
</section>

<!-- ============ SCHEDULE ============ -->
<section id="schedule" class="reveal">
  <div class="wrap">
    <div class="title"><span class="script">The Big Day</span><h2>Order of the Day</h2><div class="line"></div></div>
    <div class="timeline">
      <div class="tl"><b>10:00 AM</b> – Guests arrive &amp; seated</div>
      <div class="tl"><b>11:00 AM</b> – Wedding ceremony</div>
      <div class="tl"><b>1:00 PM</b> – Photos with the couple</div>
      <div class="tl"><b>2:00 PM</b> – Reception &amp; lunch</div>
      <div class="tl"><b>5:00 PM</b> – Cake cutting &amp; speeches</div>
      <div class="tl"><b>7:00 PM</b> – Dance &amp; celebration</div>
      <div class="tl"><b>11:59 PM</b> – Countdown to 2027 🎆</div>
    </div>
  </div>
</section>

<!-- ============ GALLERY ============ -->
<section class="gallery reveal" id="gallery">
  <div class="wrap">
    <div class="title"><span class="script">Moments</span><h2>Our Gallery</h2><div class="line"></div></div>
    <div class="grid">
      <div class="g1"></div><div class="g2"></div><div class="g3"></div><div class="g4"></div>
      <div class="g5"></div><div class="g6"></div><div class="g7"></div><div class="g8"></div>
    </div>
  </div>
</section>

<!-- ============ WISHES ============ -->
<section class="wishes reveal" id="wishes">
  <div class="wrap">
    <div class="wish-card">
      <div class="heart">💖</div>
      <h3>Congratulations, George &amp; Emmaculate!</h3>
      <p>On this beautiful journey into marriage, we wish you success and happiness in your union.</p>
      <p>May your home be filled with love, laughter and peace, and may God bless every step you take together as one.</p>
      <p>Here's to a lifetime of joy, growth and unforgettable memories. 🥂</p>
      <div class="sign">With love &amp; best wishes</div>
    </div>
  </div>
</section>

<!-- ============ RSVP ============ -->
<section class="rsvp reveal" id="rsvp">
  <div class="wrap">
    <div class="title"><span class="script">Will you join us?</span><h2>RSVP</h2><div class="line"></div></div>
    <p class="note">Kindly let us know by <b>1 December 2026</b>.</p>
    <form id="rsvpForm">
      <input type="text" id="name" placeholder="Your full name" required>
      <input type="tel" id="phone" placeholder="Phone number">
      <select id="attend"><option>Joyfully accepts 🎉</option><option>Regretfully declines</option></select>
      <input type="number" id="guests" min="1" max="10" value="1" placeholder="Number of guests">
      <textarea id="msg" placeholder="Leave a message for the couple..."></textarea>
      <button class="btn" type="submit">Send RSVP via WhatsApp</button>
    </form>
  </div>
</section>

<footer>
  <div class="script">George &amp; Emmaculate</div>
  <p>31 December 2026 · Siaya, Kenya</p>
  <p style="opacity:.6;margin-top:10px">Made with ❤️</p>
</footer>

<script>
  /* ============ EDIT THESE ============ */
  const WEDDING_DATE = new Date('2026-12-31T11:00:00+03:00');   // ceremony time (Kenya, UTC+3)
  const WHATSAPP_NUMBER = '254700000000';  // <-- put your number: country code, no + or spaces

  /* Countdown */
  function tick(){
    let diff = WEDDING_DATE - new Date();
    if(diff < 0) diff = 0;
    const p = (id,v)=>document.getElementById(id).textContent = v;
    p('d', Math.floor(diff/864e5));
    p('h', Math.floor(diff/36e5)%24);
    p('m', Math.floor(diff/6e4)%60);
    p('s', Math.floor(diff/1e3)%60);
  }
  tick(); setInterval(tick,1000);

  /* Floating hearts */
  const hs = document.getElementById('hearts');
  const sym = ['❤','💖','✨','💛','🌸'];
  for(let i=0;i<22;i++){
    const e = document.createElement('i');
    e.textContent = sym[i%sym.length];
    e.style.left = Math.random()*100+'%';
    e.style.fontSize = (14+Math.random()*22)+'px';
    e.style.animationDuration = (9+Math.random()*10)+'s';
    e.style.animationDelay = (Math.random()*10)+'s';
    hs.appendChild(e);
  }

  /* Scroll reveal */
  const io = new IntersectionObserver(es=>es.forEach(x=>{if(x.isIntersecting)x.target.classList.add('show')}),{threshold:.12});
  document.querySelectorAll('.reveal').forEach(el=>io.observe(el));

  /* RSVP -> WhatsApp */
  document.getElementById('rsvpForm').addEventListener('submit',e=>{
    e.preventDefault();
    const g = id=>document.getElementById(id).value;
    const text = `Hello! RSVP for George & Emmaculate's wedding%0A`+
      `Name: ${encodeURIComponent(g('name'))}%0APhone: ${encodeURIComponent(g('phone'))}%0A`+
      `Response: ${encodeURIComponent(g('attend'))}%0AGuests: ${g('guests')}%0AMessage: ${encodeURIComponent(g('msg'))}`;
    window.open(`https://wa.me/${WHATSAPP_NUMBER}?text=${text}`,'_blank');
  });
</script>
</body>
</html>